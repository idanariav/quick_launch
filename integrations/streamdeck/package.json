{
	"name": "quicklaunch-streamdeck",
	"private": true,
	"description": "Stream Deck plugin that runs QuickLaunch commands (PLAN M12, decision 0019).",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.idanariav.quicklaunch\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@elgato/streamdeck": "3.0.1",
		"@elgato/utils": "0.6.0"
	},
	"devDependencies": {
		"@elgato/cli": "1.10.1",
		"@rollup/plugin-commonjs": "29.0.3",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-typescript": "12.3.0",
		"@tsconfig/node20": "20.1.10",
		"@types/node": "20.19.43",
		"rollup": "4.63.5",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	}
}
